# cache dir, used by antidote's plugin bundle and zsh's completion cache <<<
ZSH_CACHE_DIR=~/.cache/zsh
[[ -d $ZSH_CACHE_DIR ]] || mkdir -p $ZSH_CACHE_DIR
# >>>

# plugins <<<
source ~/.local/share/antidote/antidote.zsh
ZSH_PLUGINS_TXT=$ZDOTDIR/.zsh_plugins.txt
ZSH_PLUGINS_ZSH="$ZSH_CACHE_DIR/plugins.zsh"
if [[ ! -f $ZSH_PLUGINS_ZSH || $ZSH_PLUGINS_TXT -nt $ZSH_PLUGINS_ZSH ]]; then
  antidote bundle <$ZSH_PLUGINS_TXT >|$ZSH_PLUGINS_ZSH
fi
source $ZSH_PLUGINS_ZSH
# >>>

# defer slow setup past first prompt <<<
if (( $+commands[kubectl] )); then
  KUBECTL_COMPLETION=$ZSH_CACHE_DIR/kubectl-completion.zsh
  if [[ ! -s $KUBECTL_COMPLETION || $commands[kubectl] -nt $KUBECTL_COMPLETION ]]; then
    kubectl completion zsh >| $KUBECTL_COMPLETION
  fi
  zsh-defer source $KUBECTL_COMPLETION
fi
zsh-defer -c '(( $+commands[fzf] )) && source <(fzf --zsh)'
# >>>

# completion system <<<
autoload -Uz compinit
# rebuild the completion dump only once a day; trust the cache otherwise
if [[ -n $ZSH_CACHE_DIR/.zcompdump(#qN.mh+24) ]]; then
  compinit -d "$ZSH_CACHE_DIR/.zcompdump"
else
  compinit -C -d "$ZSH_CACHE_DIR/.zcompdump"
fi
# compile the dump to bytecode so zsh parses it once, not every startup
if [[ -s "$ZSH_CACHE_DIR/.zcompdump" && ( ! -s "$ZSH_CACHE_DIR/.zcompdump.zwc" || "$ZSH_CACHE_DIR/.zcompdump" -nt "$ZSH_CACHE_DIR/.zcompdump.zwc" ) ]]; then
  zcompile "$ZSH_CACHE_DIR/.zcompdump"
fi
zmodload zsh/complist

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' menu select=5
zstyle ':completion:*' group-name ''
zstyle ':completion:*' verbose true
zstyle ':completion:*' special-dirs ..
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path $ZSH_CACHE_DIR
zstyle ':completion:*:approximate:' max-errors 'reply=( $((($#PREFIX+$#SUFFIX)/3)) numeric )'
zstyle ':completion:*:processes' command 'ps -au$USER'
zstyle ':completion:*:manuals' separate-sections true
zstyle ':completion:*:manuals.*' insert-sections true
zstyle ':completion:*:man:*' menu yes select

bindkey -M menuselect '\e^M' accept-and-menu-complete
bindkey -M menuselect '^o'   accept-and-infer-next-history
# >>>

# fzf-tab: fuzzy-filter the completion menu, with previews <<<
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:complete:(nvim|cat|bat):*' fzf-preview 'bat --color=always $realpath'
zstyle ':fzf-tab:complete:git-(log|show|diff):*' fzf-preview 'git diff --color=always $word'
# >>>

# keybindings <<<
autoload -Uz edit-command-line
zle -N edit-command-line

zle -C hist-complete complete-word _generic
zstyle ':completion:hist-complete:*' completer _history

sudo-command-line() {
  [[ -z $BUFFER ]] && zle up-history
  if [[ $BUFFER != sudo\ * ]]; then
    BUFFER="sudo $BUFFER"
    CURSOR=$(( CURSOR + 5 ))
  fi
}
zle -N sudo-command-line

alias run-help >&/dev/null && unalias run-help
autoload -Uz run-help run-help-git

bindkey -e
bindkey '^ '     autosuggest-accept  # ctrl-space accepts the current autosuggestion
bindkey ' '      magic-space        # history expansion on space
bindkey '\ee'    edit-command-line  # edit the command line in $EDITOR
bindkey '\ei'    menu-complete      # menu completion
bindkey '^X^X'   hist-complete      # complete word from history
bindkey '^Os'    sudo-command-line  # prepend sudo to the command line
