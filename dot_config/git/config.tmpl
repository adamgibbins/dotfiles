[user]
  name = Adam Gibbins
  signingkey = ~/.ssh/id_ed25519.pub
  email = {{ .email }}

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers

[format]
  numbered = auto

[pager]
  status = true
  show-branch = true

[alias]
  st = status -sb
  ci = commit
  co = checkout
  d = diff -b
  b = branch -av
  pp = !git pull --rebase && git push
  staged = diff --cached
  unstaged = diff
  both = diff HEAD
  worddiff = diff --word-diff
  oneline = log --oneline --decorate
  amend = commit --amend
  graph = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  who = "!sh -c 'git log -1 --pretty=\"format:%an <%ae>\" --author=\"$1\"' -"
  msg = commit --allow-empty -m
  unstage = reset HEAD
  uncommit = reset --soft HEAD^
  branch-touched = for-each-ref --sort=-committerdate refs/remotes/ --format='%(refname:short) %(committerdate:short) %(authorname)'
  git = !git
  ab = absorb --and-rebase
  dft = difftool -y -t difftastic
  nav = -c pager.diff=diffnav-auto diff

[core]
  fsmonitor = true
  untrackedCache = true
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  syntax-theme = ansi
  line-numbers-minus-style = 1
  line-numbers-plus-style = 2
  line-numbers-zero-style = 7
  line-numbers = true
  side-by-side = true
  navigate = true
  hyperlinks = true
  hyperlinks-file-link-format = vscode://file/{path}:{line}

[delta "light-mode"]
  light = true

[column]
  ui = auto

[help]
  autocorrect = 10

[commit]
  gpgsign = true
  verbose = true

[tag]
  gpgsign = true
  sort = version:refname

[diff]
  tool = nvimdiff
  algorithm = histogram
  colorMoved = default
  mnemonicPrefix = true
  renames = true

[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"

[branch]
  sort = -committerdate

[merge]
  conflictstyle = zdiff3
  tool = nvimdiff

# Opt in per repo: * merge=mergiraf
[merge "mergiraf"]
  name = mergiraf
  driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L

[fetch]
  prune = true

[transfer]
  fsckObjects = true

[rerere]
  enabled = true

[pull]
  rebase = true

[rebase]
  autoStash = true
  updateRefs = true

[push]
  default = current
  autoSetupRemote = true
  followTags = true

[init]
  defaultBranch = main

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[lfs]
  # GitHub lacks pure SSH; skip slow probe
  sshtransfer = never

[include]
  path = ~/.config/git/config-local
