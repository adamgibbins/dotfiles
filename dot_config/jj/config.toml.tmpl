"$schema" = "https://docs.jj-vcs.dev/latest/config-schema.json"

[user]
name = "Adam Gibbins"
email = {{ .email | quote }}

[ui]
# Explicit to silence the default hint
default-command = "log"

[signing]
# Sign on push, not every commit
behavior = "drop"
backend = "ssh"
key = "~/.ssh/id_ed25519.pub"
backends.ssh.allowed-signers = "~/.config/git/allowed_signers"

[git]
sign-on-push = true
# Block pushing wip: commits
private-commits = 'description(glob-i:"wip:*")'

[revsets]
# Skip empty working copy when advancing
bookmark-advance-to = 'closest_pushable(@)'

[revset-aliases]
# Nearest mutable, described, non-empty ancestor
'closest_pushable(to)' = 'heads(::to & mutable() & ~description(exact:"") & (~empty() | merges()))'
# Mutable commits reachable from x
'stack()' = 'stack(@)'
'stack(x)' = 'stack(x, 2)'
'stack(x, n)' = 'ancestors(reachable(x, mutable()), n)'

[template-aliases]
# Shortest unique change ID
'format_short_change_id(id)' = 'id.shortest()'

[aliases]
tug = ['bookmark', 'advance']
difft = ['diff', '--tool', 'difft']
# Rebase current stack onto trunk
restack = ['rebase', '-o', 'trunk()', '-s', 'roots(trunk()..) & stack()']

[templates]
# Show diff in editor, like git commit -v
draft_commit_description = '''
concat(
  builtin_draft_commit_description,
  "\nJJ: ignore-rest\n",
  diff.git(),
)
'''

[[--scope]]
--when.repositories = ["~/src/adamgibbins"]
[--scope.user]
email = "adam@adamgibbins.com"

