"$schema" = "https://docs.jj-vcs.dev/latest/config-schema.json"

[user]
name = "Adam Gibbins"
email = {{ .email | quote }}

[ui]
# Explicit to silence the default hint
default-command = "log"

[signing]
# Sign on push, not every commit
behavior = "drop"
backend = "ssh"
key = "~/.ssh/id_ed25519.pub"
backends.ssh.allowed-signers = "~/.config/git/allowed_signers"

[git]
sign-on-push = true
# Block pushing wip: commits
private-commits = 'description(glob-i:"wip:*")'

[revsets]
# Skip empty working copy when advancing
bookmark-advance-to = 'closest_pushable(@)'

[revset-aliases]
# Nearest mutable, described, non-empty ancestor
'closest_pushable(to)' = 'heads(::to & mutable() & ~description(exact:"") & (~empty() | merges()))'
# Mutable commits reachable from x
'stack()' = 'stack(@)'
'stack(x)' = 'stack(x, 2)'
'stack(x, n)' = 'ancestors(reachable(x, mutable()), n)'
# All my unmerged stacks
'open()' = 'stack(mine() | @, 1) ~ hidden()'
# r and the heads making it immutable
'why_immutable(r)' = '(r & immutable()) | roots(r:: & immutable_heads())'
# Commits containing x
'd:x' = 'diff_lines(substring:x)'
# Commits from the last month
'recent()' = 'recent(all())'
'recent(r)' = 'r & author_date(after:"1 month ago")'

[template-aliases]
# Shortest unique change ID
'format_short_change_id(id)' = 'id.shortest()'

[aliases]
tug = ['bookmark', 'advance']
difft = ['diff', '--tool', 'difft']
# Rebase current stack onto trunk
restack = ['rebase', '-o', 'trunk()', '-s', 'roots(trunk()..) & stack()']
# Rebase all stacks onto trunk
restack-all = ['rebase', '-o', 'trunk()', '-s', '(::trunk())+ & mutable()']
# Unmerged stacks
open = ['log', '-r', 'open()']
# Current stack only
stack = ['log', '-r', 'stack()']
# Add empty commits, as a todo list
plan = ['new', '--no-edit', 'heads(@::)', '-m']

[templates]
git_push_bookmark = '"adamgibbins/push-" ++ change_id.short()'
# Show diff in editor, like git commit -v
draft_commit_description = '''
concat(
  builtin_draft_commit_description,
  "\nJJ: ignore-rest\n",
  diff.git(),
)
'''

[fix.tools.gofmt]
command = ["gofmt"]
patterns = ["glob:'**/*.go'"]

[fix.tools.prettier]
command = ["prettier", "--stdin-filepath", "$path"]
patterns = ["glob:'**/*.{js,jsx,ts,tsx,json,yaml,yml,md,css,html}'"]

[fix.tools.ruff]
command = ["ruff", "format", "--stdin-filename", "$path", "-"]
patterns = ["glob:'**/*.{py,pyi}'"]

[fix.tools.rustfmt]
command = ["rustfmt", "--edition", "2024"]
patterns = ["glob:'**/*.rs'"]

[fix.tools.shfmt]
command = ["shfmt", "--filename", "$path"]
patterns = ["glob:'**/*.{sh,bash}'"]

[fix.tools.stylua]
command = ["stylua", "--stdin-filepath", "$path", "-"]
patterns = ["glob:'**/*.lua'"]

[fix.tools.terraform]
command = ["terraform", "fmt", "-"]
patterns = ["glob:'**/*.{tf,tfvars}'"]

[[--scope]]
--when.repositories = ["~/src/adamgibbins"]
[--scope.user]
email = "adam@adamgibbins.com"

