{{- if .personal -}}
Include ~/.orbstack/ssh/config
{{- end }}
Include ~/.ssh/config.d/*

Host *
    {{- if .personal }}
    User aeg
    {{- else }}
    User adamgibbins
    {{- end }}
    UseKeychain yes
    AddKeysToAgent yes
    ServerAliveInterval 60
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m

Match exec "test \"$TERM\" = tmux-256color"
    SetEnv TERM=xterm-256color
