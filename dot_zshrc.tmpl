# prompt <<<
autoload -Uz colors && colors
autoload -Uz vcs_info

zstyle ':vcs_info:*' max-exports 1
zstyle ':vcs_info:*' actionformats "%{${fg[magenta]}%}(%s)%{${fg[yellow]}%}-%{${fg[magenta]}%}[%{${fg[green]}%}%b%{${fg[yellow]}%}|%{${fg[red]}%}%a%{${fg[magenta]}%}]%{${reset_color}%} "
zstyle ':vcs_info:*' formats       "%{${fg[magenta]}%}(%s)%{${fg[yellow]}%}-%{${fg[magenta]}%}[%{${fg[green]}%}%b%{${fg[magenta]}%}]%{${reset_color}%} "

setopt prompt_subst
setopt transient_rprompt

precmd() { vcs_info }

if [[ $TERM == dumb ]]; then
    PROMPT='%(?..%? )%n@%m %40<...<%B%~%b%<< %# '
else
    if (( EUID != 0 )); then
        PROMPT="%(?..%{${fg_bold[red]}%}%?%{${reset_color}%} )%{${fg[blue]}%}%n%{${reset_color}%}@%m %40<...<%B%~%b%<< "
    else
        PROMPT="%(?..%{${fg_bold[blue]}%}%?%{${reset_color}%} )%{${fg_bold[red]}%}%n%{${reset_color}%}@%m %40<...<%B%~%b%<< "
    fi
    PROMPT="${PROMPT}"'${vcs_info_msg_0_}'"%# "
fi
RPROMPT='%(?..:() '
