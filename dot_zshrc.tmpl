# functions <<<
freload() { while (( $# )); do unfunction $1; autoload -Uz $1; shift; done }
compdef _functions freload

edalias() { [[ -z "$1" ]] && { echo "Usage: edalias <alias_to_edit>"; return 1 } || vared aliases'[$1]' }
compdef _aliases edalias

edfunc() { [[ -z "$1" ]] && { echo "Usage: edfunc <function_to_edit>"; return 1 } || zed -f "$1" }
compdef _functions edfunc
autoload -Uz zed

profile() { ZSH_PROFILE_RC=1 $SHELL "$@" }

mcd() { mkdir -p "$@" && cd "$@" }
cdt() { local t=$(mktemp -d); echo "$t"; builtin cd "$t" }

# cd to the containing directory if given a file, e.g. `cd /etc/fstab`
cd() {
    if (( $# == 1 )) && [[ -f $1 ]]; then
        [[ ! -e ${1:h} ]] && return 1
        print "Correcting ${1} to ${1:h}"
        builtin cd ${1:h}
    else
        builtin cd "$@"
    fi
}

dash() { open "dash://$(urlencode $@)" }
dman() { open "dash://man:$(urlencode $@)" }

drm() { docker rm $(docker ps -q -a) }
dri() { docker rmi $(docker images -q) }
db() { docker build -t="$1" . }
