# options <<<
setopt append_history       # append rather than overwrite the history file
setopt share_history        # import new commands from the history file live
setopt extended_history     # record timestamp + duration per command
setopt histignorealldups    # drop the older duplicate when one is re-run
setopt histignorespace      # don't record lines starting with a space
setopt auto_cd              # `cd`-able name on its own acts as `cd name`
setopt extended_glob        # enable #, ~ and ^ in globs
setopt auto_pushd           # push the old directory onto the directory stack
setopt pushd_ignore_dups    # ...without duplicates
setopt nonomatch            # don't error out on a glob with no matches
setopt nobeep
setopt notify               # report background job status immediately
setopt completeinword       # allow completion in the middle of a word
setopt interactivecomments  # allow # comments on the command line
setopt correct              # command-name spelling correction

# don't flash a reverse-video % placeholder when redrawing the prompt after
# a completion listing
unsetopt prompt_sp

HISTFILE=~/.zsh_history
HISTSIZE=5000
SAVEHIST=10000
REPORTTIME=5 # warn if a command used more than 5s of CPU time

typeset -U path cdpath fpath manpath
# >>>

# directory stack persistence <<<
DIRSTACKSIZE=20
DIRSTACKFILE=~/.zdirs

if [[ -f $DIRSTACKFILE ]] && (( ${#dirstack} == 0 )); then
    dirstack=( ${(f)"$(< $DIRSTACKFILE)"} )
    [[ -d $dirstack[1] ]] && cd $dirstack[1] && cd $OLDPWD
fi

chpwd() {
    [[ -n $DIRSTACKFILE ]] || return
    local -aU stack
    stack=( $PWD $dirstack )
    print -l $stack >! $DIRSTACKFILE
}
